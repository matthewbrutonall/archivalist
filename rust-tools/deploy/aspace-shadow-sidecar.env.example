# Copy to /etc/archivalist/aspace-shadow-sidecar.env and adapt for the canary host.
# Keep the listener on loopback unless a protected reverse proxy is required.
ARCHIVALIST_SIDECAR_HOST=127.0.0.1
ARCHIVALIST_SIDECAR_PORT=4570
ARCHIVALIST_SOLR_URL=http://127.0.0.1:8985/solr
ARCHIVALIST_SHADOW_COLLECTION=archivesspace_shadow
